generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String              @id
  email         String              @unique
  name          String              @default("Caçador")
  whatsapp      String?
  level         Int                 @default(1)
  xp            Int                 @default(0)
  coins         Int                 @default(0)
  classRole     String              @default("Recruta")
  gender        String?
  age           Int?
  policeClass   String?
  isPCD         Boolean             @default(false)
  race          String?
  inteligencia  Int                 @default(0)
  forca         Int                 @default(0)
  disciplina    Int                 @default(0)
  espirito      Int                 @default(0)
  streakDays    Int                 @default(0)
  spiritualType String              @default("Católico")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  examAttempts  ExamAttempt[]
  leiSecaDays   LeiSecaDay[]
  missionLogs   MissionLog[]
  topicProgress UserTopicProgress[]
}

model LeiSecaDay {
  id          String    @id @default(uuid())
  userId      String
  dayNumber   Int
  completed   Boolean   @default(false)
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayNumber])
}

model Subject {
  id          String       @id @default(uuid())
  name        String
  colorHex    String       @default("#00E5FF")
  importance  Int          @default(1)
  missionLogs MissionLog[]
  topics      Topic[]
}

model Topic {
  id           String              @id @default(uuid())
  subjectId    String
  title        String
  order        Int                 @default(0)
  missionLogs  MissionLog[]
  subject      Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userProgress UserTopicProgress[]
}

model UserTopicProgress {
  id                 String  @id @default(uuid())
  userId             String
  topicId            String
  isTheoryDone       Boolean @default(false)
  revisionsCompleted Int     @default(0)
  masteryLevel       Int     @default(1)
  topic              Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

model MissionLog {
  id                String   @id @default(uuid())
  userId            String
  missionType       String
  subjectId         String?
  topicId           String?
  category          String?
  durationMin       Int?
  questionsDone     Int?     @default(0)
  questionsRight    Int?     @default(0)
  runDistanceMeters Int?
  swimTimeSeconds   Int?
  pullUpsCount      Int?
  spiritualDone     Boolean  @default(false)
  date              DateTime @default(now())
  notes             String?
  subject           Subject? @relation(fields: [subjectId], references: [id])
  topic             Topic?   @relation(fields: [topicId], references: [id])
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exam {
  id          String        @id @default(uuid())
  title       String
  provider    String
  description String?
  createdAt   DateTime      @default(now())
  attempts    ExamAttempt[]
  questions   Question[]
}

model Question {
  id            String       @id @default(uuid())
  examId        String
  text          String
  associatedText String?
  options       Json
  correctAnswer String
  explanation   String?
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  userAnswers   UserAnswer[]
}

model ExamAttempt {
  id         String       @id @default(uuid())
  userId     String
  examId     String
  score      Int          @default(0)
  total      Int          @default(0)
  finishedAt DateTime?
  createdAt  DateTime     @default(now())
  exam       Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers    UserAnswer[]
}

model UserAnswer {
  id         String      @id @default(uuid())
  attemptId  String
  questionId String
  answer     String
  isCorrect  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}
